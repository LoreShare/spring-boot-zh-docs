{
  "name": "spring-boot-4-1-0-zh-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spring Boot 4.1.0 非官方中文文档站 MVP",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "sync:source": "node scripts/sync-source.mjs",
